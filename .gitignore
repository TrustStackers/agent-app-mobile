# ── Node ──────────────────────────────────────────────────────────────────────
# Matches at any depth, so it also covers www/nodejs/node_modules/.
node_modules/

# ── Capacitor / native platforms ──────────────────────────────────────────────
# Generated by `npx cap add android` / `cap add ios`, and rebuilt by
# `npm run setup`, which re-applies the Node 24 runtime URL in variables.gradle.
android/
ios/
local.properties

# ── Generated by `npm run setup` ──────────────────────────────────────────────
# The packed @p2p-trust-stack tarballs. Regenerate with `npm run setup`.
vendor/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
.gradle/
*.apk
*.aab
*.tgz

# ── Secrets ───────────────────────────────────────────────────────────────────
# Signing material and any local dotenv file. NOTE: www/nodejs/bootstrap.env is
# deliberately NOT ignored — it is the committed relay config and must be
# committed (see the README's "Relay configuration"). The explicit exception
# below keeps it safe if a broader pattern is ever added.
*.keystore
*.jks
.env
.env.local
.env.*.local
!www/nodejs/bootstrap.env

# ── Runtime data (lives on the device, never in the repo) ─────────────────────
*.db
*.db-wal
*.db-shm

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.log

